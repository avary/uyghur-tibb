{
  "name": "uyghur-tibb",
  "version": "1.0.0",
  "private": true,
  "description": "Uyghur Traditional Medicine education platform (PWA) - Node serverless API + MySQL backend",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "migrate": "node migrate.js",
    "migrate:seed": "node migrate.js --seed",
    "migrate:from-supabase": "node migrate.js --from-supabase",
    "migrate:to-supabase": "node migrate.js --to-supabase",
    "recipes:seed": "node scripts/seed-recipes.mjs",
    "recipes:validate": "node scripts/validate-recipes.mjs",
    "herbs:import": "node scripts/import-herbs.mjs",
    "herbs:validate": "node scripts/validate-herbs.mjs",
    "herbs:seed": "node scripts/seed-herbs.mjs",
    "farhiz:import": "node scripts/import-farhiz.mjs",
    "mizaj:import": "node scripts/import-mizaj.mjs",
    "books:validate": "node scripts/validate-book-topics.mjs",
    "books:validate:distinct": "node scripts/validate-book-topics.mjs vite/src/data/farhiz.json --different-from vite/src/data/mizaj.json",
    "books:compare": "node scripts/compare-book-sources.mjs",
    "git:check-private": "node scripts/check-private-data.mjs",
    "git:setup-hooks": "sh scripts/setup-git-hooks.sh",
    "dev": "node dev.js",
    "start": "node dev.js",
    "test": "node --test \"tests/*.test.js\"",
    "vite:dev": "npm --prefix vite run dev",
    "vite:build": "npm --prefix vite run build",
    "vite:preview": "npm --prefix vite run preview"
  },
  "dependencies": {
    "mysql2": "^3.11.0"
  }
}
