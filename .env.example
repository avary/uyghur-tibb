# ============================================================
# API environment configuration — you must pick a BACKEND DRIVER
# Copy this file to `.env` and fill in real values.
# These are read by migrate.js and must be set as Vercel
# Environment Variables for the serverless functions.
# ============================================================

# --- Backend driver choice (VERCEL DEPLOYMENT) ---
# One of: "mysql" (default) or "supabase". Unset = auto: supabase wins only
# when SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY are set and MYSQL_* are not.
# An EXPLICIT driver with missing credentials FAILS CLOSED (startup error).
# Clients (supabase.js / the Vue app) never see which backend is in use.
DB_DRIVER=mysql

# --- MySQL connection (used when DB_DRIVER=mysql) ---
# MYSQL_PASSWORD must be non-empty — an empty password is treated as "not configured".
MYSQL_HOST=your-mysql-host.example.com
MYSQL_PORT=3306
MYSQL_USER=uyghur_tibb_app
MYSQL_PASSWORD=change-me-strong-password
MYSQL_DATABASE=uyghur_tibb

# --- Supabase (used when DB_DRIVER=supabase) ---
# Apply supabase_setup.sql in the Supabase SQL Editor first.
# SUPABASE_SERVICE_ROLE_KEY is SERVER-ONLY: it grants full DB access and must
# never be shipped in the browser, committed, or exposed in client code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin auth secret (used to sign login tokens) ---
# Set a STRONG, unique value. This is the only "admin password" (both drivers).
ADMIN_PASSWORD=change-me-strong-admin-password

# --- CORS: allowed origin for the deployed app ---
# e.g. https://uyghur-tibb.vercel.app
# Leave empty to fail CLOSED on cross-origin requests (same-origin always works).
ALLOWED_ORIGIN=https://uyghur-tibb.vercel.app

# --- Legacy: anon/public key + source project for data migration ---
# Used only by: node migrate.js --from-supabase (Supabase -> MySQL), and only as a
# FALLBACK — that migrator prefers SUPABASE_SERVICE_ROLE_KEY (bypasses source RLS).
# The API itself never uses the anon key.
SUPABASE_ANON_KEY=
