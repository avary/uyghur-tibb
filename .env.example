# ============================================================
# MySQL + API environment configuration
# Copy this file to `.env` and fill in real values.
# These are read by migrate.js and must be set as Vercel
# Environment Variables for the serverless functions.
# ============================================================

# --- MySQL connection (remote) ---
MYSQL_HOST=your-mysql-host.example.com
MYSQL_PORT=3306
MYSQL_USER=uyghur_tibb_app
MYSQL_PASSWORD=change-me-strong-password
MYSQL_DATABASE=uyghur_tibb

# --- Admin auth secret (used to sign login tokens) ---
# Set a STRONG, unique value. This is the only "admin password".
ADMIN_PASSWORD=change-me-strong-admin-password

# --- CORS: allowed origin for the deployed app ---
# e.g. https://uyghur-tibb.vercel.app  (leave empty to allow all / same-origin)
ALLOWED_ORIGIN=https://uyghur-tibb.vercel.app

# --- Optional: source for data migration from an existing Supabase project ---
# Leave blank if starting fresh. Used only by: node migrate.js --from-supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
